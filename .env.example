# Copy is created automatically by `npm run setup`. Never commit the real .env.
DATABASE_URL="file:../data/app.db"
# Generated by setup — a long random string used to sign dashboard sessions.
SESSION_SECRET=""
# Public origin of the dashboard. The extension only talks to this origin.
APP_ORIGIN="http://localhost:3000"
# Browser channel for Playwright WordPress sessions: chrome | msedge | chromium
BROWSER_CHANNEL="chrome"
# Optional: full path to a Chrome binary; overrides BROWSER_CHANNEL
BROWSER_EXECUTABLE_PATH=""
# Optional licensed search API for the Plagiarism Evidence Checker.
SERPER_API_KEY=""
# Optional disposable WordPress for E2E tests only.
WP_E2E_ADMIN_URL=""
